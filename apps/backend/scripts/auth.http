### POST /auth/register - valid
POST http://localhost:9090/auth/register
Content-Type: application/json

{
  "name": "Test User",
  "email": "test@example.com",
  "password": "secret123"
}

### POST /auth/login - valid credentials
POST http://localhost:9090/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "secret123"
}

### POST /auth/login - invalid email
POST http://localhost:9090/auth/login
Content-Type: application/json

{
  "email": "nonexistent@example.com",
  "password": "secret123"
}

### POST /auth/login - wrong password
POST http://localhost:9090/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "wrongpassword"
}

### POST /auth/login - invalid email format
POST http://localhost:9090/auth/login
Content-Type: application/json

{
  "email": "not-an-email",
  "password": "secret123"
}

### POST /auth/login - missing body
POST http://localhost:9090/auth/login
Content-Type: application/json

{}
